        "cve": {
          "id": "CVE-2026-115533",
          "sourceIdentifier": "cret@cert.org",
          "published": "2026-10-26T20:17:51.053",
          "lastModified": "2026-10-27T16:04:22.707",
          "vulnStatus": "Deferred",
          "cveTags": [],
          "descriptions": [
            {
              "lang": "en",
              "value": "The LeRobot library is vulnerable to arbitrary code execution via unsafe dynamic class instantiation in the from_pretrained() method and related paths. When loading a policy's processor configuration from a repository,  the library uses the class field within the JSON configuration to dynamically resolve and instantiate Python classes using importlib.import_module() and getattr()."
            }
          ],
          "affected": [
            {
              "source": "cret@cert.org",
              "affectedData": [
